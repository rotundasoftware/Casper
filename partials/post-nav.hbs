{{!--

Previous/next post links, displayed at the end of every post.
The feed is ordered newest-first, so "previous" is the newer post
({{next_post}} in Ghost terms) and "next" is the older one.

--}}

<section class="post-nav-wrap gh-canvas">
    <nav class="post-nav" aria-label="Previous and next posts">
        {{#next_post}}
            <a class="post-nav-link post-nav-prev" href="{{url}}"><i class="fa-regular fa-chevron-left"></i>Previous</a>
        {{else}}
            <span class="post-nav-link post-nav-prev disabled" aria-disabled="true"><i class="fa-regular fa-chevron-left"></i>Previous</span>
        {{/next_post}}
        {{#prev_post}}
            <a class="post-nav-link post-nav-next" href="{{url}}">Next<i class="fa-regular fa-chevron-right"></i></a>
        {{else}}
            <span class="post-nav-link post-nav-next disabled" aria-disabled="true">Next<i class="fa-regular fa-chevron-right"></i></span>
        {{/prev_post}}
    </nav>
</section>
